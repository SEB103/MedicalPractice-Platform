{
  "name": "medicalpractice-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "check": "quasar prepare && vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests quasar.config.ts",
    "format": "prettier --write src tests quasar.config.ts"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "pinia": "^3.0.0",
    "quasar": "2.35.0",
    "vue": "^3.5.0",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@quasar/app-vite": "3.10.2",
    "@types/node": "^24.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
